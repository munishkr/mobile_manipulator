# Copy to .env and edit. docker compose reads .env from this directory.
ROS_DISTRO=jazzy
USER_UID=1001
USER_GID=1001
DISPLAY=:1

# LOCALHOST = this machine only. SUBNET = discoverable by robots on the LAN.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_DOMAIN_ID=43
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Rendering. GLX_VENDOR=mesa on a machine without an NVIDIA GPU.
GLX_VENDOR=nvidia
NV_PRIME_RENDER_OFFLOAD=1
