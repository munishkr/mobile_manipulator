<?xml version="1.0"?>
<sdf version="1.9">

  <world name="tabletop">

    <!-- Physics runs single-threaded; at the default 1 ms step the A200 + Kinova + Dex3
         model only reached ~0.22x real time. 4 ms = 4x fewer steps per sim second.
         If grasps or wheel contacts get jittery, drop to 0.002. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics" />

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands" />

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />

    <!-- Drives the base IMU (sensors.imu in ~/clearpath/robot.yaml) used by the EKF for yaw.
         Not the rendering Sensors system, so it does not clash with the robot model's. -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu" />


    <!-- Lighting -->
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 -0.4 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>5 5 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>5 5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landmark_1">
      <static>true</static>
      <pose>-1.4 1.2 0 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="landmark_2">
      <static>true</static>
      <pose>-1.55 -1.25 0 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="landmark_3">
      <static>true</static>
      <pose>1.70 1.55 0 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.60 1.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Table -->
    <model name="table">
      <pose>1.15 0 0 0 0 0</pose>
      <static>true</static>

      <link name="table_link">

        <!-- Table top -->
        <collision name="top_collision">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="top_visual">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.2 1</ambient>
            <diffuse>0.55 0.35 0.2 1</diffuse>
          </material>
        </visual>

        <!-- Table support -->
        <collision name="support_collision">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.70</size>
            </box>
          </geometry>
        </collision>

        <visual name="support_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.70</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Cylindrical cup -->
    <model name="cup">
      <pose>0.95 0 0.811 0 0 0</pose>
      <static>false</static>

      <link name="cup_link">

        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000226</ixx>
            <iyy>0.000226</iyy>
            <izz>0.0000919</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>

</sdf>